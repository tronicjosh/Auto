# Copy to .env and fill in. .env is gitignored — never commit a real key.

# Required: your Claude API key.
ANTHROPIC_API_KEY=sk...

# Required: the EMPTY source workbook the tool copies dropdowns/structure from. It is NOT bundled
# with the project — point this at your IXUS template .xlsx. It is read-only (never written to)
# and must be a SEPARATE file from the batch sheet below.
IXUS_TEMPLATE=C:\path\to\IXUS_template.xlsx

# Required: the batch sheet (.xlsx) the tool populates (overwritten on every run). This is the
# OUTPUT — a different file from the template above.
IXUS_BATCH_SHEET=C:\path\to\IXUS_batch_sheet.xlsx

# Optional:
# IXUS_DATASHEET_ROOT=C:\path\to\datasheets     # where the "browse datasheet" dialog opens
#
# The AI models are NOT set here — they live in config/meta.json ("model" for extraction,
# "classify_model" for the router), so they version with the prompts.
