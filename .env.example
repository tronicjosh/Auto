# Copy to .env and fill in. .env is gitignored — never commit a real key.

# Required: your Claude API key.
ANTHROPIC_API_KEY=sk-ant-...

# Required: the EMPTY source workbook the tool copies dropdowns/structure from. It is NOT bundled
# with the project — point this at your IXUS template .xlsx. It is read-only (never written to)
# and must be a SEPARATE file from the batch sheet below.
IXUS_TEMPLATE=C:\Users\joshj\Desktop\IXUS_antenna_batch_processor_template.xlsx

# Required: the batch sheet (.xlsx) the tool populates IN PLACE (overwritten on every run). This
# is the OUTPUT — a different file from the template above.
# Production: C:\alphawave\Git Workspace\engineering\antenna_toolbox\data\IXUS_antenna_batch_processor.xlsx
IXUS_BATCH_SHEET=C:\Users\joshj\Desktop\IXUS_antenna_batch_processor.xlsx

# Optional:
# IXUS_DATASHEET_ROOT=C:\Users\joshj\Desktop      # where the "browse datasheet" dialog opens
#
# The AI models are NOT set here — they live in workflow_configs/antenna/meta.json
# ("model" for extraction, "classify_model" for the router), so they version with the prompts.
