# Copy to .env and fill in. .env is gitignored — never commit a real key.

# Required: your Claude API key.
ANTHROPIC_API_KEY=sk-ant-...

# The batch sheet (.xlsx) the tool populates IN PLACE (overwritten on every change).
# Production: C:\alphawave\Git Workspace\engineering\antenna_toolbox\data\IXUS_antenna_batch_processor.xlsx
IXUS_BATCH_SHEET=C:\Users\joshj\Desktop\IXUS_antenna_batch_processor.xlsx

# Optional overrides (sensible defaults apply if unset):
# IXUS_DATASHEET_ROOT=C:\Users\joshj\Desktop      # where the "browse datasheet folder" dialog opens
# IXUS_TEMPLATE=...\IXUS_antenna_batch_processor2 1.xlsx   # source workbook (dropdowns) to copy from
# IXUS_EXTRACT_MODEL=claude-opus-4-8              # override the extraction model
# IXUS_CLASSIFY_MODEL=claude-haiku-4-5            # override the router/classify model
